{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": false,
    "module": "ES6",
    "target": "ES6",
    "lib": ["DOM", "ES2022"],
    "moduleResolution": "node",
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationDir": "./dist",
    "baseUrl": "./",
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "types": ["jest"],
    "paths": {
      "@opentelemetry/instrumentation-user-interaction": [
        "./src/opentelemetry-js-contrib/packages/instrumentation-user-interaction"
      ],
      "@opentelemetry/instrumentation-document-load": [
        "./src/opentelemetry-js-contrib/packages/instrumentation-document-load"
      ],
      "@opentelemetry/instrumentation-long-task": [
        "./src/opentelemetry-js-contrib/packages/instrumentation-long-task"
      ]
    }
  },
  "exclude": ["./dist", "./src/opentelemetry-js-contrib"]
}
