{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": false,
    "module": "ES6",
    "target": "ES6",
    "lib": ["DOM", "ES2022"],
    "moduleResolution": "node",
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationDir": "./dist",
    "baseUrl": "./",
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "types": ["jest"],
    "paths": {
      "web-vitals-v6": ["./node_modules/web-vitals/src/index.ts"],
      "@opentelemetry/api": ["./src/opentelemetry-js/api"],
      "@opentelemetry/semantic-conventions": [
        "./src/opentelemetry-js/semantic-conventions"
      ],
      "@opentelemetry/otlp-exporter-base/browser-http": [
        "./src/opentelemetry-js/experimental/packages/otlp-exporter-base/src/index-browser-http.ts"
      ],
      "@opentelemetry/*": [
        "./src/opentelemetry-js/packages/*",
        "./src/opentelemetry-js/packages/opentelemetry-*",
        "./src/opentelemetry-js/packages/sdk-*",
        "./src/opentelemetry-js/experimental/packages/*",
        "./src/opentelemetry-js/experimental/packages/opentelemetry-*",
        "./src/opentelemetry-js-contrib/packages/*"
      ]
    }
  },
  "exclude": [
    "./dist",
    "./src/opentelemetry-js",
    "./src/opentelemetry-js-contrib"
  ]
}
